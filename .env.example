# Opcional: webhook para capturar leads (Make, n8n, Zapier)
BONUS_LEAD_WEBHOOK_URL=

# Credenciais do storage (AWS S3 ou Cloudflare R2 S3-compatible)
BONUS_AWS_ACCESS_KEY_ID=
BONUS_AWS_SECRET_ACCESS_KEY=

# Bucket e arquivo privado
BONUS_S3_BUCKET=
BONUS_S3_KEY=Arte_de_Hablar_con_IA.zip

# S3 AWS: mantenha vazio para endpoint
# R2: use https://<accountid>.r2.cloudflarestorage.com
BONUS_S3_ENDPOINT=

# AWS: ex. us-east-1
# R2: use auto
BONUS_S3_REGION=us-east-1

# Normalmente true para R2 e false para S3 AWS
BONUS_S3_FORCE_PATH_STYLE=
